<?xml version="1.0" encoding="utf-8"?>
<!--
  点图表浮出来的数字气泡(2026-09-19)。

  用近乎不透明的深色而不是半透明的面板色:这个气泡会压在柱子/文字上面,底下的图形要能
  **被它盖住**。半透明的话柱子会从字后面透出来,读数字反而费劲 —— 它是一块"贴上去的标签",
  不是页面里的一张卡。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#F2262C3A" />
    <corners android:radius="9dp" />
    <stroke android:width="1dp" android:color="#337AA2FF" />
</shape>
