<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0D11"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="-0.02"
            android:text="歌词中继"
            android:textColor="#EEF1F5"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="18dp"
            android:text="读取正在播放，推送到 Mac 悬浮歌词"
            android:textColor="#8B93A1"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/statusPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/pill_bg"
            android:paddingLeft="10dp"
            android:paddingTop="5dp"
            android:paddingRight="10dp"
            android:paddingBottom="5dp"
            android:text="未启动"
            android:textColor="#FF7B72"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/panel_bg"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mac 连接"
                android:textColor="#8B93A1"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/discoveryStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="正在自动发现同一 Wi-Fi 下的 Mac…"
                android:textColor="#7AA2FF"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/macIp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/input_bg"
                android:hint="例如 172.20.10.2"
                android:inputType="textUri"
                android:padding="12dp"
                android:textColor="#EEF1F5"
                android:textColorHint="#5C6470"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/macPort"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/input_bg"
                android:hint="端口"
                android:inputType="number"
                android:padding="12dp"
                android:text="8765"
                android:textColor="#EEF1F5"
                android:textColorHint="#5C6470"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/pairingCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/input_bg"
                android:hint="Mac 上显示的 6 位配对码"
                android:inputType="number"
                android:maxLength="6"
                android:padding="12dp"
                android:textColor="#EEF1F5"
                android:textColorHint="#5C6470"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnPair"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_primary"
                android:text="配对并保存"
                android:textColor="#0B0D11" />

            <Button
                android:id="@+id/btnTest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_ghost"
                android:text="测试连接"
                android:textColor="#EEF1F5" />
        </LinearLayout>

        <Button
            android:id="@+id/toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/btn_primary"
            android:padding="14dp"
            android:text="启动中继"
            android:textColor="#0B0D11"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:text="权限与保活"
            android:textColor="#8B93A1"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnNotifAccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/btn_ghost"
            android:text="1. 开启通知使用权"
            android:textColor="#EEF1F5" />

        <Button
            android:id="@+id/btnBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn_ghost"
            android:text="2. 关闭电池优化（保活）"
            android:textColor="#EEF1F5" />

        <TextView
            android:id="@+id/detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="3dp"
            android:text="未启动"
            android:textColor="#8B93A1"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
